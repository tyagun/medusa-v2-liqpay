{
  "name": "medusa-plugin-liqpay",
  "version": "0.1.0",
  "description": "LiqPay payments for Medusa v2: a payment provider for LiqPay hosted checkout, a checkout-outcome store route, and an order widget in Admin.",
  "license": "MIT",
  "author": "tyagun (https://github.com/tyagun)",
  "homepage": "https://github.com/tyagun/medusav2-liqpay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyagun/medusav2-liqpay.git"
  },
  "bugs": {
    "url": "https://github.com/tyagun/medusav2-liqpay/issues"
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-payment",
    "medusa-payment",
    "liqpay",
    "privatbank",
    "ukraine",
    "payments",
    "uah"
  ],
  "files": [
    ".medusa/server",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/payment-recovery.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": {
      "types": "./.medusa/server/src/workflows/index.d.ts",
      "default": "./.medusa/server/src/workflows/index.js"
    },
    "./lib": {
      "types": "./.medusa/server/src/lib/index.d.ts",
      "default": "./.medusa/server/src/lib/index.js"
    },
    "./.medusa/server/src/modules/*": {
      "types": "./.medusa/server/src/modules/*/index.d.ts",
      "default": "./.medusa/server/src/modules/*/index.js"
    },
    "./modules/*": {
      "types": "./.medusa/server/src/modules/*/index.d.ts",
      "default": "./.medusa/server/src/modules/*/index.js"
    },
    "./providers/*": {
      "types": "./.medusa/server/src/providers/*/index.d.ts",
      "default": "./.medusa/server/src/providers/*/index.js"
    },
    "./*": {
      "types": "./.medusa/server/src/*.d.ts",
      "default": "./.medusa/server/src/*.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json",
    "test": "jest",
    "prepublishOnly": "npm test && medusa plugin:build",
    "check:storefront": "node scripts/check-storefront.mjs"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.22.7",
    "@medusajs/cli": "2.22.7",
    "@medusajs/eslint-plugin": "2.22.7",
    "@medusajs/framework": "2.22.7",
    "@medusajs/icons": "2.22.7",
    "@medusajs/js-sdk": "2.22.7",
    "@medusajs/medusa": "2.22.7",
    "@medusajs/test-utils": "2.22.7",
    "@medusajs/ui": "4.2.9",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@tanstack/react-query": "5.64.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jiti": "^2.0.0",
    "next": "15.5.29",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "13.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.7",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.22.0",
    "@medusajs/framework": "^2.22.0",
    "@medusajs/icons": "^2.22.0",
    "@medusajs/js-sdk": "^2.22.0",
    "@medusajs/medusa": "^2.22.0",
    "@medusajs/ui": "^4.0.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "npm@11.6.1",
  "overrides": {
    "bullmq": {
      "uuid": "11.1.1"
    },
    "next": {
      "postcss": "8.5.33"
    }
  }
}
